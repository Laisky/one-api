{
  "name": "react-template",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@douyinfe/semi-icons": "^2.103.0",
    "@douyinfe/semi-ui": "^2.103.0",
    "@types/qrcode": "^1.5.6",
    "@visactor/react-vchart": "~1.8.11",
    "@visactor/vchart": "~1.8.11",
    "@visactor/vchart-semi-theme": "~1.8.8",
    "axios": "^1.20.0",
    "history": "^5.3.0",
    "marked": "^4.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.4.1",
    "react-fireworks": "^1.0.4",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "react-telegram-login": "^1.1.2",
    "react-toastify": "^9.1.3",
    "react-turnstile": "^1.1.5",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.3",
    "usehooks-ts": "^2.16.0"
  },
  "scripts": {
    "start": "FAST_REFRESH=true react-scripts start",
    "dev": "FAST_REFRESH=true GENERATE_SOURCEMAP=true react-scripts start",
    "dev:backend": "FAST_REFRESH=true GENERATE_SOURCEMAP=true REACT_APP_VERSION=$(node -e 'process.stdout.write(Math.floor(Date.now()/1000).toString())') PORT=3002 react-scripts start",
    "build": "react-scripts build && rm -rf ../build/air && mv -f build ../build/air",
    "build:dev": "GENERATE_SOURCEMAP=true react-scripts build && rm -rf ../build/air && mv -f build ../build/air",
    "build:prod": "DISABLE_ESLINT_PLUGIN='true' REACT_APP_VERSION=$(node -e 'process.stdout.write(Math.floor(Date.now()/1000).toString())') react-scripts build && rm -rf ../build/air && mv -f build ../build/air",
    "pretest": "node --experimental-vm-modules --test ../../.github/scripts/legacy-api-compat.test.mjs && node --test ../../.github/scripts/legacy-dependency-security.test.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "prettier": "2.8.8",
    "typescript": "4.4.2"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true
  },
  "proxy": "http://100.113.170.10:3000",
  "resolutions": {
    "**/jsonpath/underscore": "1.13.8",
    "**/geojson-flatten/minimist": "1.2.8"
  }
}
