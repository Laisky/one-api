diff --git a/common/string_event.go b/common/string_event.go
new file mode 100644
index 0000000..13ace0e
--- /dev/null
+++ b/common/string_event.go
@@ -0,0 +1,17 @@
+package common
+
+import "net/http"
+
+// StringEvent is an already formatted SSE string, without the generic CustomEvent formatting step.
+type StringEvent string
+
+// Render writes the same headers, escaped bytes and delimiters as CustomEvent for a string payload.
+func (r StringEvent) Render(w http.ResponseWriter) error {
+	r.WriteContentType(w)
+	return writeStringData(w, string(r))
+}
+
+// WriteContentType preserves CustomEvent content-type and caller-supplied cache-control semantics.
+func (r StringEvent) WriteContentType(w http.ResponseWriter) {
+	CustomEvent{}.WriteContentType(w)
+}
